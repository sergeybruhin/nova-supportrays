{
    "name": "sergeybruhin/nova-supportrays",
    "description": "Laravel Nova 4 tool for working SupportRays («Лучи Поддержки») tickets from the admin panel, as each Nova user's own SupportRays manager account",
    "keywords": ["sergeybruhin", "supportrays", "laravel", "nova", "helpdesk"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Sergey Bruhin",
            "email": "sundaycreative@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/nova": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "SergeyBruhin\\NovaSupportRays\\": "src"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "SergeyBruhin\\NovaSupportRays\\Providers\\NovaSupportRaysServiceProvider"
            ]
        }
    }
}
